new file mode 100644
index 00000000..3b6095db
--- /dev/null
+++ b/tui_gateway/ws_request_order.py
@@ -0,0 +1,91 @@
+"""Socket-local completion fences for early control projections, not an execution queue."""
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+# These handlers act on the exact ref they authorize. Resume/activate can resolve a
+# title, short ID or physical lineage segment: keep those (and unknown verbs) fenced.
+_EXACT_SESSION_METHODS = frozenset({
+    'session.control.read', 'session.export', 'session.info',
+    'session.detach', 'session.interrupt', 'session.events.since',
+    'process.list', 'subagent.list', 'subagent.tail', 'approval.pending',
+})
+_PROFILE_FENCED_METHODS = frozenset({'session.resume', 'session.mutate', 'session.create', 'session.list'})
+
+
+def request_scope(connection: Any, request: Any) -> tuple[str, str | None] | None:
+    """Only split a proven exact-session request; routing/authorization still run at dispatch."""
+    if connection is None or not isinstance(request, dict):
+        return None
+    params = request.get('params')
+    if not isinstance(params, dict):
+        return None
+    sid = params.get('session_id')
+    method = request.get('method')
+    if method in _PROFILE_FENCED_METHODS:
+        sid = None
+    elif method not in _EXACT_SESSION_METHODS or not isinstance(sid, str) or not sid:
+        return None  # unknown/sessionless verbs may mutate process-wide state
+    authority = connection.authority
+    profile = params.get('profile')
+    if profile:
+        if not isinstance(profile, str):
+            return None
+        from hermes_cli.profiles import profile_matches_home
+        if not profile_matches_home(profile, Path(authority.profile_id)):
+            if not connection.host_scoped:
+                return None
+            registry = getattr(authority.runner, 'session_authorities', ())
+            authority = next((item for item in registry
+                              if profile_matches_home(profile, Path(item.profile_id))), None)
+            if authority is None:
+                starting = registry.starting(profile) if registry else None
+                return (starting[0], None) if starting is not None else None
+    if sid is not None:
+        live = authority.sessions.get(sid)
+        from gateway.config import Platform
+        source = getattr(live, 'source', None)
+        # The mounted LOCAL owner is already canonical in memory. Cold IDs, history
+        # segments and messaging routes require owner resolution; do not read SQLite
+        # on the receive loop just to speculate that they are independent.
+        if source is None or source.platform != Platform.LOCAL or source.chat_id != sid:
+            sid = None
+    return (authority.profile_id, sid)
+
+
+def overlaps(left, right) -> bool:
+    return (left is None or right is None or
+            (left[0] == right[0] and (left[1] is None or right[1] is None or left[1] == right[1])))
+
+
+@dataclass(eq=False)
+class OrderedRequest:
+    request: Any
+    dependencies: tuple[asyncio.Future, ...]
+    finished: asyncio.Future
+
+    async def ready(self) -> None:
+        if self.dependencies:
+            # Cancelling a waiter must not cancel its predecessor's shared completion.
+            await asyncio.wait(self.dependencies)
+
+    def finish(self) -> None:
+        if not self.finished.done():
+            self.finished.set_result(None)
+
+
+class RequestOrder:
+    """Track only admitted in-flight frames; their existing lanes own execution and bounds."""
+    def __init__(self):
+        self.pending = {}
+
+    def admit(self, request, scope, *, early=False):
+        dependencies = tuple(done for done, (other, was_early) in self.pending.items()
+                             if (early or was_early) and overlaps(scope, other))
+        done = asyncio.get_running_loop().create_future()
+        self.pending[done] = (scope, early)
+        done.add_done_callback(self.pending.pop)
+        return OrderedRequest(request, dependencies, done)
