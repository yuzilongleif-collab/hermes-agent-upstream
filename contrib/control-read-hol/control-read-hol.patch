index 00000000..7286c6d5
--- /dev/null
+++ b/tests/gateway/fixtures/control_read_ordering_peer.py
@@ -0,0 +1,170 @@
+"""Authenticated WS ordering probes; only a storage leaf is paused, no model calls."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+import traceback
+
+
+class Replies:
+    def __init__(self, ws):
+        self.ws = ws
+        self.frames = []
+        self.waiters = {}
+        self.task = asyncio.create_task(self.read())
+
+    async def read(self):
+        async for raw in self.ws:
+            frame = json.loads(raw)
+            self.frames.append(frame)
+            waiter = self.waiters.get(frame.get('id'))
+            if waiter is not None and not waiter.done():
+                waiter.set_result(frame)
+
+    async def send(self, rid, method, **params):
+        future = asyncio.get_running_loop().create_future()
+        self.waiters[rid] = future
+        await self.ws.send(json.dumps({'jsonrpc': '2.0', 'id': rid, 'method': method, 'params': params}))
+        return future
+
+    async def call(self, rid, method, **params):
+        future = await self.send(rid, method, **params)
+        return await asyncio.wait_for(asyncio.shield(future), 10)
+
+    async def close(self):
+        self.task.cancel()
+        await asyncio.gather(self.task, return_exceptions=True)
+
+
+async def probe(mode):
+    from gateway.run import GatewayRunner
+    from gateway.session_authority import initialize_session_authority
+    from gateway.run_api import start_gateway_api, stop_gateway_api
+    from hermes_cli import web_server
+    from hermes_cli.dashboard_auth.ws_tickets import mint_ticket
+    from tests.waiting import async_wait_until
+    from websockets.asyncio.client import connect
+
+    home = Path(os.environ['HERMES_HOME'])
+    (home / 'config.yaml').write_text('gateway:\n  multiplex_profiles: false\nmodel:\n  provider: custom\n  default: no-inference\n  base_url: http://127.0.0.1:1/v1\nauxiliary:\n  title_generation:\n    enabled: false\n')
+    runner = GatewayRunner()
+    authority = await initialize_session_authority(runner, profile_id=str(home), instance_id='ordering')
+    api = await start_gateway_api(runner)
+    web_server.app.state.auth_required = True
+    from tests.gateway.fixtures.control_read_lifetime_cases import ConnectionWatch
+    watcher = ConnectionWatch()
+
+    def socket():
+        ticket = mint_ticket(user_id='owner', provider='fixture')
+        return connect(api.api_origin.replace('http:', 'ws:') + '/api/ws?ticket=' + ticket)
+
+    entered, release, exited = threading.Event(), threading.Event(), threading.Event()
+    original = authority.db.get_session
+    record = {'mode': mode, 'authenticated_ws': True, 'no_inference': True}
+    try:
+        async with socket() as ws, socket() as other:
+            replies, second = Replies(ws), Replies(other)
+            try:
+                ids = []
+                for index in range(2):
+                    created = await replies.call('create' + str(index), 'session.create',
+                                                 request_id='ordering' + str(index), source='gui', toolsets=[])
+                    assert 'result' in created, created
+                    ids.append(created['result']['session_id'])
+                a, b = ids
+                warm = await replies.call('warm', 'session.control.read', session_id=b)
+                assert 'result' in warm, warm
+
+                from functools import partial
+                from tests.gateway.fixtures.control_read_ordering_cases import (
+                    mutation_lineage_case, resume_case, successor_case,
+                )
+                from tests.gateway.fixtures.control_read_lifetime_cases import (
+                    lifetime_case, permission_case, started_disconnect_case,
+                )
+                cases = {
+                    **{key: partial(resume_case, authority, replies, a, b, record, key) for key in
+                       ('resume', 'resume-short', 'resume-lineage', 'resume-other')},
+                    **{key: partial(successor_case, authority, replies, a, b, record, key) for key in
+                       ('successor', 'successor-lineage')},
+                    **{key: partial(lifetime_case, authority, replies, a, b, record, key, watcher) for key in
+                       ('disconnect', 'cancel-flood')},
+                    'permissions': partial(permission_case, authority, replies, a, record),
+                    'mutation-lineage': partial(mutation_lineage_case, authority, replies, a, record),
+                    'disconnect-started': partial(started_disconnect_case, authority, replies, second, a, record, watcher),
+                }
+                if mode in cases:
+                    await cases[mode]()
+                    return
+
+                def paused(sid, *args, **kwargs):
+                    if sid == a and threading.current_thread() is not threading.main_thread():
+                        entered.set()
+                        try:
+                            assert release.wait(15), 'export leaf watchdog expired'
+                        finally:
+                            exited.set()
+                    return original(sid, *args, **kwargs)
+
+                authority.db.get_session = paused
+                same = mode in {'same-export', 'same-profile-alias'}
+                export_params = {'profile': 'default'} if mode == 'same-profile-alias' else {}
+                control_params = {}  # omitted profile and explicit 'default' are the supported aliases
+                export = await replies.send('export', 'session.export', session_id=a, format='json', **export_params)
+                await async_wait_until(entered.is_set, timeout=5, what='real export storage worker entered')
+                start = time.monotonic()
+                control = await replies.send('control', 'session.control.read', session_id=a if same else b, **control_params)
+                ping = await replies.call('ping', 'gateway.ping')
+                assert ping.get('result') == {'ok': True}, ping
+                independent = await second.call('second', 'session.control.read', session_id=b)
+                assert 'result' in independent, independent
+                try:
+                    answer = await asyncio.wait_for(asyncio.shield(control), 2)
+                except TimeoutError:
+                    answer = None
+                record.update(control_before_release=answer is not None,
+                              control_wait_ms=(time.monotonic() - start) * 1000,
+                              ping_before_release=True, second_socket_before_release=True)
+                if same:
+                    assert answer is None, 'same-session control overtook its export predecessor'
+                    release.set()
+                    answer = await asyncio.wait_for(asyncio.shield(control), 10)
+                    assert 'result' in answer, answer
+                    ids = [frame.get('id') for frame in replies.frames]
+                    assert ids.index('export') < ids.index('control'), ids
+                else:
+                    assert answer is not None, 'control(B) remained behind real export(A) on the same socket'
+                    assert 'result' in answer and answer['result'] == independent['result'], answer
+                    assert not export.done() and not release.is_set()
+            finally:
+                release.set()
+                authority.db.get_session = original
+                if entered.is_set():
+                    await async_wait_until(exited.is_set, timeout=5, what='export worker exited')
+                if 'export' in replies.waiters:
+                    finished = await asyncio.wait_for(asyncio.shield(replies.waiters['export']), 10)
+                    assert 'result' in finished, finished
+                await replies.close()
+                await second.close()
+    finally:
+        await stop_gateway_api(api)
+        watcher.close()
+        record['paused_worker_exited'] = not entered.is_set() or exited.is_set()
+        record['imports'] = {name: str(Path(str(sys.modules[name].__file__)).resolve()) for name in
+                             ('tui_gateway.ws', 'gateway.session_controls', 'gateway.session_ancillary', 'hermes_state')}
+        (home / 'receipt.json').write_text(json.dumps(record, indent=2))
+
+
+if __name__ == '__main__':
+    status = 0
+    try:
+        asyncio.run(probe(sys.argv[1]))
+    except BaseException:
+        traceback.print_exc()
+        status = 1
+    sys.stdout.flush()
+    sys.stderr.flush()
+    os._exit(status)
