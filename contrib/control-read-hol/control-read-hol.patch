@@ -0,0 +1,36 @@
+"""Real authenticated TCP regression for control reads behind foreign-session work."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+from tests.gateway.fixtures.local_recovery_probe import child_env
+
+
+def probe(tmp_path, mode):
+    root = Path(__file__).resolve().parents[2]
+    home, user = tmp_path / 'state', tmp_path / 'user'
+    home.mkdir()
+    user.mkdir()
+    env = child_env()
+    env.update(HOME=str(user), USERPROFILE=str(user), HERMES_HOME=str(home),
+               PYTHONPATH=str(root), PYTHONUNBUFFERED='1', PYTHONDONTWRITEBYTECODE='1',
+               HERMES_DISABLE_LAZY_INSTALLS='1')
+    result = subprocess.run([sys.executable, str(root / 'tests/gateway/fixtures/control_read_ordering_peer.py'), mode],
+                            cwd=root, env=env, capture_output=True, text=True, timeout=90, check=False)
+    receipt = json.loads((home / 'receipt.json').read_text()) if (home / 'receipt.json').exists() else {}
+    print(json.dumps(receipt))
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert receipt['authenticated_ws'] and receipt['paused_worker_exited']
+    return receipt
+
+
