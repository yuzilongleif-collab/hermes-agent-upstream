+"""Unknown socket scope cannot be inferred from an absent session ID (architect counterexample)."""
+import asyncio
+
+import pytest
+
+pytest_plugins = ('tests.gateway.test_sibling_attach_while_profile_starting',)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('method', ['profiles.list', 'not.a.known.method'])
+async def test_unknown_scope_fences_a_secondary_control_read(rig, monkeypatch, method):
+    from tui_gateway import ws as ws_mod
+    from tests.gateway.fixtures.control_read_ordering_cases import remains_pending
+    original = ws_mod._dispatch_request
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    async def observed(connection, request, name, transport):
+        if request.get('id') == 'unknown-scope':
+            entered.set()
+            await release.wait()
+        return await original(connection, request, name, transport)
+
+    monkeypatch.setattr(ws_mod, '_dispatch_request', observed)
+    sock = await rig.connect()
+    rig.create(sock, 'alpha', 'alpha-for-fence')
+    created = await sock.reply('alpha-for-fence')
+    sid = created['result']['session_id']
+    sock.inbound.put_nowait({'jsonrpc': '2.0', 'id': 'unknown-scope', 'method': method, 'params': {}})
+    await asyncio.wait_for(entered.wait(), 5)
+    sock.inbound.put_nowait({'jsonrpc': '2.0', 'id': 'secondary-control', 'method': 'session.control.read',
+                            'params': {'profile': 'alpha', 'session_id': sid}})
+    control = asyncio.create_task(sock.reply('secondary-control'))
+    try:
+        await remains_pending(control)
+    finally:
+        release.set()
+    first, second = await asyncio.gather(sock.reply('unknown-scope'), control)
+    if method == 'profiles.list':
+        assert 'result' in first, first
+    else:
+        assert first['error']['code'] == -32601, first
+    assert 'result' in second, second
+    assert sock.order.index('unknown-scope') < sock.order.index('secondary-control'), sock.order
