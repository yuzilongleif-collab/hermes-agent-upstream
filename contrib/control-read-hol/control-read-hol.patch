+++ b/tests/gateway/fixtures/control_read_lifetime_cases.py
@@ -0,0 +1,146 @@
+"""Real TCP disconnect/shutdown probes; wrappers only observe the native paths."""
+import asyncio
+import json
+import threading
+
+from tests.waiting import async_wait_until
+
+
+class ConnectionWatch:
+    def __init__(self):
+        from tui_gateway import ws
+        self.module = ws
+        self.original = ws.handle_ws
+        self.connections = []
+        ws.handle_ws = self.handle
+
+    async def handle(self, socket, **kwargs):
+        row = {'task': asyncio.current_task(), 'done': asyncio.Event(), 'received': []}
+        self.connections.append(row)
+        original_receive = socket.receive_text
+
+        async def receive():
+            raw = await original_receive()
+            row['received'].append(json.loads(raw))
+            return raw
+
+        socket.receive_text = receive
+        try:
+            return await self.original(socket, **kwargs)
+        finally:
+            row['done'].set()
+
+    def close(self):
+        self.module.handle_ws = self.original
+
+
+async def lifetime_case(authority, replies, a, b, record, mode, watcher):
+    from gateway import session_ancillary as ancillary
+    from gateway import session_policy_refresh as refresh
+    entered = asyncio.Event()
+    pending = asyncio.get_running_loop().create_future()
+    authority._policy_refreshes = {a: pending}
+    original_refresh, original_read = refresh.refresh_settled, ancillary.read
+    calls = []
+
+    async def observed_refresh(owner, sid):
+        if owner is authority and sid == a:
+            entered.set()
+        return await original_refresh(owner, sid)
+
+    async def observed_read(connection, ref, params, **kwargs):
+        calls.append(ref.session_id)
+        return await original_read(connection, ref, params, **kwargs)
+
+    refresh.refresh_settled, ancillary.read = observed_refresh, observed_read
+    connection = watcher.connections[0]
+    try:
+        await replies.send('blocked-resume', 'session.resume', session_id=a, omit_messages=True)
+        await asyncio.wait_for(entered.wait(), 5)
+        if mode == 'cancel-flood':
+            from tui_gateway.ws import _WS_CONCURRENT_READ_LIMIT, _WS_WAITING_READ_LIMIT
+            limit = _WS_CONCURRENT_READ_LIMIT + _WS_WAITING_READ_LIMIT
+            for index in range(limit * 3):
+                await replies.send('waiting-' + str(index), 'session.control.read', session_id=a)
+            # The limit+1 frame is read and then parks admission; no later frame can be read.
+            await async_wait_until(lambda: len([r for r in connection['received']
+                                                if str(r.get('id', '')).startswith('waiting-')]) == limit + 1,
+                                   timeout=5, what='native bounded reader parked at admission')
+            assert not calls, calls
+            connection['task'].cancel()
+            await asyncio.wait_for(connection['done'].wait(), 5)
+            assert not pending.done(), 'cancelling a socket cancelled the shared policy refresh'
+            record.update(read_admission_bound=limit, unstarted_reads_dropped=True, server_cancel_exited=True)
+        else:
+            await replies.send('waiting-control', 'session.control.read', session_id=a)
+            await replies.send('successor-info', 'session.info', session_id=a)
+            assert (await replies.call('before-disconnect', 'gateway.ping'))['result']['ok']
+            await replies.ws.close()
+            assert not connection['done'].is_set(), 'disconnect closed authority under a running resume'
+            pending.set_result(None)
+            await asyncio.wait_for(connection['done'].wait(), 10)
+            assert not calls, 'a control read waiting for its predecessor ran after disconnect'
+            record.update(disconnect_drained=True, unstarted_reads_dropped=True)
+    finally:
+        if not pending.done():
+            pending.set_result(None)
+        refresh.refresh_settled, ancillary.read = original_refresh, original_read
+        authority._policy_refreshes.pop(a, None)
+
+
+async def permission_case(authority, replies, a, record):
+    from tests.gateway.test_sibling_attach_while_profile_starting import _Socket
+    from tui_gateway.ws import handle_ws
+    sock = _Socket(authority)
+    task = asyncio.create_task(handle_ws(sock, auth_identity={
+        'user_id': 'unprivileged', 'profile_id': authority.profile_id, 'capabilities': []}))
+    try:
+        sock.inbound.put_nowait({'jsonrpc': '2.0', 'id': 'denied', 'method': 'session.control.read',
+                                'params': {'session_id': a}})
+        denied = await sock.reply('denied', timeout=5)
+        assert denied['error']['message'] == 'permission_denied', denied
+    finally:
+        sock.inbound.put_nowait(None)
+        await asyncio.wait_for(task, 10)
+    for rid, params, expected in [
+        ('foreign', {'session_id': a, 'profile': 'foreign'}, 'profile_mismatch'),
+        ('injected', {'session_id': a, 'user_id': 'owner'}, 'invalid_params'),
+        ('missing', {'session_id': 'absent-session'}, 'not_found'),
+    ]:
+        response = await replies.call(rid, 'session.control.read', **params)
+        assert response['error']['message'] == expected, response
+    valid = await replies.call('after-rejections', 'session.control.read', session_id=a)
+    assert 'result' in valid, valid
+    record.update(capability_denied=True, profile_denied=True, invalid_params_denied=True,
+                  not_found_preserved=True, rejection_fences_released=True)
+
+
+async def started_disconnect_case(authority, replies, second, a, record, watcher):
+    original = authority.db.get_compression_tip
+    entered, release, exited = threading.Event(), threading.Event(), threading.Event()
+
+    def observed(sid, *args, **kwargs):
+        if sid == a and threading.current_thread() is not threading.main_thread():
+            entered.set()
+            try:
+                assert release.wait(15), 'started control worker watchdog expired'
+            finally:
+                exited.set()
+        return original(sid, *args, **kwargs)
+
+    authority.db.get_compression_tip = observed
+    try:
+        await replies.send('started-control', 'session.control.read', session_id=a)
+        await async_wait_until(entered.is_set, timeout=5, what='started control worker')
+        await replies.ws.close()
+        assert not watcher.connections[0]['done'].is_set(), 'teardown ran underneath a started read'
+        assert (await second.call('started-disconnect-ping', 'gateway.ping'))['result']['ok']
+        release.set()
+        await asyncio.wait_for(watcher.connections[0]['done'].wait(), 10)
+        assert exited.is_set()
+        record.update(started_read_drained=True, paused_worker_exited=True, peer_ping_during_drain=True)
+    finally:
+        release.set()
+        authority.db.get_compression_tip = original
+        if entered.is_set():
+            await async_wait_until(exited.is_set, timeout=5, what='started control worker exited')
diff --git a/tests/gateway/fixtures/control_read_ordering_cases.py b/tests/gateway/fixtures/control_read_ordering_cases.py
