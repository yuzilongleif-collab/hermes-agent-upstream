index 00000000..b86c3ef2
--- /dev/null
+++ b/tests/gateway/fixtures/control_read_ordering_cases.py
@@ -0,0 +1,155 @@
+"""Ordering assertions through the peer's real WS/authority handlers."""
+import asyncio
+import threading
+
+from tests.waiting import async_wait_until
+
+
+async def remains_pending(future):
+    done, _ = await asyncio.wait({future}, timeout=2)
+    assert not done, 'request overtook an earlier overlapping request'
+
+
+def compressed_target(authority, owner):
+    from tests.gateway.test_local_resume_compression_child import _compress
+    live = authority.sessions[owner]
+    store = authority.runner.session_store
+    store._record_gateway_session_peer(owner, live.route, live.source)
+    child = 'ordering-physical-child'
+    _compress(authority.db, owner, child, 'local')
+    store._record_gateway_session_peer(child, live.route, live.source)
+    return child
+
+
+async def resume_case(authority, replies, a, b, record, mode):
+    from gateway import session_policy_refresh as refresh
+    from gateway.session_control_actions import publish_async
+    from hermes_cli.goals import GoalState
+    requested = a[:22] if mode == 'resume-short' else a
+    if mode == 'resume-lineage':
+        requested = compressed_target(authority, a)
+    refreshing = requested if mode == 'resume-lineage' else a
+    original = refresh.refresh_settled
+    entered = asyncio.Event()
+    pending = asyncio.get_running_loop().create_future()
+    authority._policy_refreshes = {refreshing: pending}
+
+    async def observed(owner, sid):
+        if owner is authority and sid == refreshing:
+            entered.set()
+        return await original(owner, sid)
+
+    refresh.refresh_settled = observed
+    try:
+        resume = await replies.send('resume', 'session.resume', session_id=requested, omit_messages=True)
+        await asyncio.wait_for(entered.wait(), 5)
+        target = b if mode == 'resume-other' else a
+        control = await replies.send('ordered', 'session.control.read', session_id=target)
+        ping = await replies.call('resume-ping', 'gateway.ping')
+        assert ping['result']['ok']
+        await remains_pending(control)
+        pending.set_result(None)
+        resumed, observed_control = await asyncio.wait_for(asyncio.gather(resume, control), 10)
+        assert 'result' in resumed and 'result' in observed_control, (resumed, observed_control)
+        assert resumed['result']['session_id'] == a, resumed
+        ids = [frame.get('id') for frame in replies.frames]
+        assert ids.index('resume') < ids.index('ordered'), ids
+        # Use the native event publisher and real subscription/stream, not a fabricated frame.
+        target = authority.db.get_compression_tip(a) or a
+        authority.db.set_meta('goal:' + target, GoalState('ORDERING_GOAL', status='paused', created_at=50).to_json())
+        await publish_async(authority, a)
+        await async_wait_until(lambda: any(frame.get('params', {}).get('type') == 'session.control.update'
+                                          for frame in replies.frames), timeout=5, what='native control update on WS')
+        events = [frame['params'] for frame in replies.frames
+                  if frame.get('params', {}).get('type') == 'session.control.update']
+        assert events[-1]['payload']['control']['goal']['title'] == 'ORDERING_GOAL', events
+        record.update(predecessor_before_control=True, native_stream_update=True, conservative_unknown_scope=True)
+    finally:
+        if not pending.done():
+            pending.set_result(None)
+        refresh.refresh_settled = original
+        authority._policy_refreshes.pop(refreshing, None)
+
+
+async def successor_case(authority, replies, a, b, record, mode='successor'):
+    mounted = await replies.call('before-successor', 'session.resume', session_id=a, omit_messages=True)
+    assert 'result' in mounted, mounted
+    revision = mounted['result']['revision']
+    target = a
+    if mode == 'successor-lineage':
+        target = compressed_target(authority, a)
+        revision = authority.db.get_session(target)['runtime_revision']
+    original = authority.db.get_compression_tip
+    entered, release, exited = threading.Event(), threading.Event(), threading.Event()
+
+    def paused(sid, *args, **kwargs):
+        if sid in {a, target} and threading.current_thread() is not threading.main_thread():
+            entered.set()
+            try:
+                assert release.wait(15), 'control storage watchdog expired'
+            finally:
+                exited.set()
+        return original(sid, *args, **kwargs)
+
+    authority.db.get_compression_tip = paused
+    try:
+        control = await replies.send('read-before-write', 'session.control.read', session_id=a)
+        await async_wait_until(entered.is_set, timeout=5, what='actual control projection worker')
+        other = await replies.send('other-control', 'session.control.read', session_id=b)
+        assert 'result' in await asyncio.wait_for(asyncio.shield(other), 5)
+        successor = await replies.send('after-read', 'session.mutate', session_id=target,
+                                       request_id='ordered-rename', expected_revision=revision,
+                                       operation='rename', payload={'title': 'ORDERED_TITLE'})
+        assert (await replies.call('successor-ping', 'gateway.ping'))['result']['ok']
+        await remains_pending(successor)
+        release.set()
+        read_result, exported = await asyncio.wait_for(asyncio.gather(control, successor), 10)
+        assert 'result' in read_result and 'result' in exported, (read_result, exported)
+        ids = [frame.get('id') for frame in replies.frames]
+        assert ids.index('read-before-write') < ids.index('after-read'), ids
+        assert authority.db.get_session(target)['title'] == 'ORDERED_TITLE'
+        record.update(control_before_successor=True, unrelated_control_during_wait=True)
+    finally:
+        release.set()
+        authority.db.get_compression_tip = original
+        if entered.is_set():
+            await async_wait_until(exited.is_set, timeout=5, what='control worker exited')
+        record['paused_worker_exited'] = not entered.is_set() or exited.is_set()
+
+
+async def mutation_lineage_case(authority, replies, a, record):
+    from gateway import session_mutations as mutations
+    child = compressed_target(authority, a)
+    revision = authority.db.get_session(child)['runtime_revision']
+    live = authority.sessions[a]
+    original = mutations._owner_ref
+    entered = asyncio.Event()
+
+    def observed(owner, ref, params):
+        result = original(owner, ref, params)
+        if ref.session_id == child:
+            assert result.session_id == a, result
+            entered.set()
+        return result
+
+    mutations._owner_ref = observed
+    await live.mutation_lock.acquire()
+    try:
+        mutation = await replies.send('segment-rename', 'session.mutate', session_id=child,
+                                      request_id='segment-rename', expected_revision=revision,
+                                      operation='rename', payload={'title': 'LINEAGE_TITLE'})
+        await asyncio.wait_for(entered.wait(), 5)
+        control = await replies.send('root-control', 'session.control.read', session_id=a)
+        assert (await replies.call('lineage-ping', 'gateway.ping'))['result']['ok']
+        await remains_pending(control)
+        live.mutation_lock.release()
+        changed, snapshot = await asyncio.wait_for(asyncio.gather(mutation, control), 10)
+        assert 'result' in changed and 'result' in snapshot, (changed, snapshot)
+        assert authority.db.get_session(child)['title'] == 'LINEAGE_TITLE'
+        ids = [frame.get('id') for frame in replies.frames]
+        assert ids.index('segment-rename') < ids.index('root-control'), ids
+        record.update(physical_mutation_before_logical_control=True)
+    finally:
+        if live.mutation_lock.locked():
+            live.mutation_lock.release()
+        mutations._owner_ref = original
diff --git a/tests/gateway/fixtures/control_read_ordering_peer.py b/tests/gateway/fixtures/control_read_ordering_peer.py
