+export function fetchOriginTasks(scope: string, profile: string, ids: readonly string[]): Promise<OriginTasksResponse> {
+  const seeds = [...new Set(ids)].sort()
+  const key = `${scope}\0${profile}\0${seeds.join('\0')}`
