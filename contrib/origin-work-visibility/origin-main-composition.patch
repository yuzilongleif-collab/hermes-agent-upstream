+++ b/apps/desktop/src/app/chat/composer/session-slot.test.tsx
@@ -0,0 +1,40 @@
+
+import { render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+
+vi.mock('@/contrib', () => ({
+  useContributions: () => [{ id: 'linked-work', data: { render: () => <span>Linked durable work</span> } }]
+}))
+vi.mock('@/store/session', async () => ({ $sessions: (await import('nanostores')).atom([]) }))
+vi.mock('@/store/session-states', async () => ({ $sessionStates: (await import('nanostores')).atom({}) }))
+vi.mock('@/store/session-route-context', async () => ({
+  $activeRoute: (await import('nanostores')).atom({}),
+  runtimeRouteContext: () => ({ ambient: true, connectionId: '', profile: 'default', sessionId: 'fixture', lineageIds: ['fixture'] })
+}))
+
+import { ComposerSessionFeedback } from './session-slot'
+
+describe('composer session feedback', () => {
+  it('keeps durable work outside the collapsed foreground drawer and preserves its mounted child', () => {
+    const { rerender } = render(
+      <ComposerSessionFeedback collapsed id="foreground-status" sessionId="fixture">
+        <button type="button">Foreground status</button>
+      </ComposerSessionFeedback>
+    )
+
