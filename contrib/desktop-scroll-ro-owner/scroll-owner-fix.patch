@@ -0,0 +1,93 @@
+import { AssistantRuntimeProvider, type ThreadMessage, useExternalStoreRuntime } from '@assistant-ui/react'
+import { act, render } from '@testing-library/react'
+import { expect, it, vi } from 'vitest'
+
+import { stubThreadEnvironment, stubThreadViewportSize } from '../test-utils'
+
+import { Thread } from '.'
+
+stubThreadEnvironment()
+stubThreadViewportSize()
+
+const CLIENT_HEIGHT = 600
+let contentHeight = 5000
+
+Object.defineProperty(HTMLElement.prototype, 'scrollHeight', { configurable: true, get: () => contentHeight })
+Object.defineProperty(HTMLElement.prototype, 'clientHeight', { configurable: true, get: () => CLIENT_HEIGHT })
+
+const createdAt = new Date('2026-01-01T00:00:00Z')
+
+const messages: ThreadMessage[] = [
+  { id: 'scroll-order-user', role: 'user', content: [{ type: 'text', text: 'Synthetic task' }], attachments: [], createdAt, metadata: { custom: {} } },
+  { id: 'scroll-order-assistant', role: 'assistant', content: [{ type: 'text', text: 'Synthetic streaming response' }], status: { type: 'running' }, createdAt, metadata: { unstable_state: null, unstable_annotations: [], unstable_data: [], steps: [], custom: {} } }
+]
+
+function Harness() {
+  const runtime = useExternalStoreRuntime<ThreadMessage>({ messages, isRunning: true, onNew: async () => {} })
+
+  return <AssistantRuntimeProvider runtime={runtime}><Thread sessionId="scroll-order-runtime" sessionKey="scroll-order" /></AssistantRuntimeProvider>
+}
+
+it('keeps the pre-growth resize baseline when the previous pin scroll event arrives before the next resize', async () => {
+  contentHeight = 5000
+  const original = globalThis.ResizeObserver
+  const observers = new Set<{ callback: ResizeObserverCallback; targets: Set<Element> }>()
+
+  vi.stubGlobal('ResizeObserver', class {
+    targets = new Set<Element>()
+    constructor(public callback: ResizeObserverCallback) { observers.add(this) }
+    observe(target: Element) { this.targets.add(target) }
+    unobserve(target: Element) { this.targets.delete(target) }
+    disconnect() { this.targets.clear() }
+  })
+
+  const { container, unmount } = render(<Harness />)
+  const viewport = container.querySelector<HTMLElement>('[data-slot="aui_thread-viewport"]')!
+
+  const resize = () => {
+    for (const observer of observers) {
+      const targets = [...observer.targets].filter(node => node.getAttribute('data-slot') === 'aui_thread-content')
+
+      if (targets.length) {
+        observer.callback(targets.map(target => ({ target, contentRect: { height: contentHeight } })) as ResizeObserverEntry[], observer as unknown as ResizeObserver)
+      }
+    }
+  }
+
+  try {
+    await act(async () => {
+      for (let tick = 0; tick < 10; tick++) {await new Promise(resolve => setTimeout(resolve, 0))}
+    })
+    expect(viewport.scrollTop).toBe(contentHeight - CLIENT_HEIGHT)
+    // Isolate the synchronous before-paint pin from the library's next rAF.
+    const frame = vi.spyOn(globalThis, 'requestAnimationFrame').mockImplementation(() => 0)
+
+    try {
+      act(() => { contentHeight += 120; resize() })
+      expect(viewport.scrollTop).toBe(contentHeight - CLIENT_HEIGHT)
+
+      // A scroll event caused by that pin can be delivered after the next DOM
+      // growth but before its ResizeObserver. It is not a fresh resize sample.
+      act(() => {
+        contentHeight += 240
+        viewport.dispatchEvent(new Event('scroll'))
+        resize()
+      })
+      expect(viewport.scrollTop).toBe(contentHeight - CLIENT_HEIGHT)
+
+      // A genuine reader escape must still win over the same resize ordering.
+      const readingTop = viewport.scrollTop - 900
+      act(() => {
+        viewport.dispatchEvent(new WheelEvent('wheel', { bubbles: true, deltaY: -160 }))
+        viewport.scrollTop = readingTop
+        viewport.dispatchEvent(new Event('scroll'))
+        contentHeight += 400
+        resize()
+      })
+      expect(viewport.scrollTop).toBe(readingTop)
+    } finally { frame.mockRestore() }
+  } finally {
+    unmount()
+    vi.stubGlobal('ResizeObserver', original)
+  }
+})
