+import { AssistantRuntimeProvider, type ThreadMessage, useAuiState, useExternalStoreRuntime } from '@assistant-ui/react'
+import { act, render } from '@testing-library/react'
+import { expect, it, vi } from 'vitest'
+
+import { rescopeConnectionScopedStores } from '@/lib/connection-scoped'
+import { setActiveProfile } from '@/store/profile'
+import { getThreadScrollPosition, saveThreadScrollPosition } from '@/store/thread-scroll'
+
+import { stubThreadEnvironment, stubThreadViewportSize } from '../test-utils'
+
+import { Thread } from '.'
+
+stubThreadEnvironment()
+stubThreadViewportSize()
+let height = 2000
+Object.defineProperty(HTMLElement.prototype, 'scrollHeight', { configurable: true, get: () => height })
+Object.defineProperty(HTMLElement.prototype, 'clientHeight', { configurable: true, get: () => 600 })
+
+const messages = (key: string, running: boolean): ThreadMessage[] => [
+  {
+    id: `u-${key}`,
+    role: 'user',
+    content: [{ type: 'text', text: `Synthetic task ${key}` }],
+    attachments: [],
+    createdAt: new Date('2026-01-01'),
+    metadata: { custom: {} }
+  },
+  {
+    id: `a-${key}`,
+    role: 'assistant',
+    content: [{ type: 'text', text: `Synthetic answer ${key}` }],
+    status: running ? { type: 'running' } : { type: 'complete', reason: 'stop' },
+    createdAt: new Date('2026-01-01'),
+    metadata: { unstable_state: null, unstable_annotations: [], unstable_data: [], steps: [], custom: {} }
+  }
+]
+
+function RunningMarker() {
+  const running = useAuiState(s => s.thread.isRunning)
+
+  return <output data-running={String(running)} data-testid="runtime-running" />
+}
+
+function Harness({ sessionKey, running }: { sessionKey: string; running: boolean }) {
+  const runtime = useExternalStoreRuntime<ThreadMessage>({
+    messages: messages(sessionKey, running),
+    isRunning: running,
+    onNew: async () => {}
+  })
+
+  return (
+    <AssistantRuntimeProvider runtime={runtime}>
+      <RunningMarker />
+      <Thread sessionId={sessionKey} sessionKey={sessionKey} />
+    </AssistantRuntimeProvider>
+  )
+}
+
+it('QA same mounted Thread preserves saved reading offset when switching from shorter A to running B before native resize', async () => {
+  window.localStorage.clear()
+  setActiveProfile('default')
+  rescopeConnectionScopedStores(null)
+  height = 2000
+  saveThreadScrollPosition('qa-boundary-B', { kind: 'offset', fromBottom: 800 })
+  expect(getThreadScrollPosition('qa-boundary-B')).toEqual({ kind: 'offset', fromBottom: 800 })
+  const original = globalThis.ResizeObserver
+  const observers = new Set<{ callback: ResizeObserverCallback; targets: Set<Element> }>()
+  vi.stubGlobal(
+    'ResizeObserver',
+    class {
+      targets = new Set<Element>()
+      constructor(public callback: ResizeObserverCallback) {
+        observers.add(this)
+      }
+      observe(target: Element) {
+        this.targets.add(target)
+      }
+      unobserve(target: Element) {
+        this.targets.delete(target)
+      }
+      disconnect() {
+        this.targets.clear()
+      }
+    }
+  )
+  const view = render(<Harness running={false} sessionKey="qa-boundary-A" />)
+  const viewport = view.container.querySelector<HTMLElement>('[data-slot="aui_thread-viewport"]')!
+
+  try {
+    await act(async () => {
+      for (let tick = 0; tick < 10; tick++) {
+        await new Promise(r => setTimeout(r, 0))
+      }
+    })
+    expect(viewport.scrollTop).toBe(1400)
+    const frame = vi.spyOn(globalThis, 'requestAnimationFrame').mockImplementation(() => 0)
+
+    try {
+      height = 5000
+      view.rerender(<Harness running sessionKey="qa-boundary-B" />)
+      // The external-store runtime publishes updated running state asynchronously.
+      // Keep rAF parked, but require the real consumer to see running=true.
+      await act(async () => {
+        for (let tick = 0; tick < 3; tick++) {
+          await new Promise(r => setTimeout(r, 0))
+        }
+      })
+      expect(view.container.querySelector('[data-testid="runtime-running"]')?.getAttribute('data-running')).toBe('true')
+      const next = view.container.querySelector<HTMLElement>('[data-slot="aui_thread-viewport"]')!
+      expect(next).toBe(viewport) // Prove real DOM/Thread lifecycle reuse.
+      expect(next.scrollTop).toBe(3600) // Restore actually consumed B's saved 800px.
+      const before = next.scrollTop
+      act(() => {
+        next.dispatchEvent(new Event('scroll'))
+
+        for (const observer of observers) {
+          const targets = [...observer.targets].filter(t => t.getAttribute('data-slot') === 'aui_thread-content')
+
+          if (targets.length) {
+            observer.callback(
+              targets.map(target => ({ target, contentRect: { height } })) as ResizeObserverEntry[],
+              observer as unknown as ResizeObserver
+            )
+          }
+        }
+      })
+      console.log(
+        'QA_SESSION_BOUNDARY',
+        JSON.stringify({
+          sameViewport: next === viewport,
+          restoredTop: before,
+          afterResizeTop: next.scrollTop,
+          fromBottom: height - 600 - next.scrollTop
+        })
+      )
+      expect(next.scrollTop).toBe(3600)
+    } finally {
+      frame.mockRestore()
+    }
+  } finally {
+    view.unmount()
+    vi.stubGlobal('ResizeObserver', original)
+  }
+})
