new file mode 100644
index 0000000000000000000000000000000000000000..35a65eb2bfad0c570bac3f446749761eb3b2c72f
--- /dev/null
+++ b/apps/desktop/src/test/scroll-continuity/fixture.tsx
@@ -0,0 +1,146 @@
+import '@/styles.css'
+
+// Synthetic data only. Production Thread, Markdown, resize observers, scroll owner,
+// runtime conversion and history reconciliation are imported, not reimplemented.
+import { AssistantRuntimeProvider, useAuiState, useExternalStoreRuntime } from '@assistant-ui/react'
+import { type CSSProperties, useCallback, useMemo, useRef, useState } from 'react'
+import { createRoot } from 'react-dom/client'
+
+import { reconcileAuthoritativeChatMessages } from '@/app/session/hooks/use-session-actions/resume-reconcile'
+import { Thread } from '@/components/assistant-ui/thread'
+import { TranscriptWindowProvider } from '@/components/assistant-ui/thread/transcript-window'
+import { type ChatMessage, chatMessageText } from '@/lib/chat-messages'
+import { toRuntimeMessage } from '@/lib/chat-runtime'
+import { requestScrollToBottom, saveThreadScrollPosition } from '@/store/thread-scroll'
+
+// Schedule the already-observed browser ordering deterministically. Only the
+// pending scroll event is synthetic; message layout and ResizeObserver are real.
+function appendBeforeDelayedScroll(rows: ChatMessage[], append: () => void, delivered: { current: number }) {
+  const target = document.querySelector<HTMLElement>(`[data-message-id="${rows.at(-1)!.id}"]`)!
+  const viewport = target.closest<HTMLElement>('[data-slot="aui_thread-viewport"]')!
+  const before = target.textContent
+
+  const observer = new MutationObserver(() => {
+    if (target.textContent !== before) {
+      observer.disconnect()
+      delivered.current += 1
+      viewport.dispatchEvent(new Event('scroll'))
+    }
+  })
+
+  observer.observe(target, { childList: true, characterData: true, subtree: true })
+  append()
+}
+
+const PROSE = 'Synthetic continuity sample. This is a stable paragraph used to measure a real message, not a private conversation. '
+const TIMESTAMP = 1767225600
+
+function makeMessages(turns = 18, repeats = 5, start = 0): ChatMessage[] {
+  return Array.from({ length: turns }, (_, offset) => {
+    const index = start + offset
+
+    return [
+      { id: `u-${index}`, role: 'user', parts: [{ type: 'text', text: `Synthetic task ${index}` }], rowId: index * 2, timestamp: TIMESTAMP },
+      { id: `a-${index}`, role: 'assistant', parts: [{ type: 'text', text: `Answer ${index}.\n\n${PROSE.repeat(repeats)}` }], rowId: index * 2 + 1, timestamp: TIMESTAMP }
+    ] as ChatMessage[]
+  }).flat()
+}
+
+function extend(row: ChatMessage, count: number): ChatMessage {
+  return { ...row, parts: [{ type: 'text', text: `${chatMessageText(row)}\n\n${PROSE.repeat(count)}` }] }
+}
+
+function RunningMarker() {
+  const running = useAuiState(state => state.thread.isRunning)
+
+  return <output data-runtime-running={String(running)} hidden />
+}
+
+function Probe() {
+  const [rows, setRows] = useState(makeMessages)
+  const [running, setRunning] = useState(false)
+  const [sessionKey, setSessionKey] = useState('synthetic-scroll')
+  const [olderAvailable, setOlderAvailable] = useState(false)
+  const saved = useRef<ChatMessage[]>([])
+  const delayedScrollDelivered = useRef(0)
+  const runtimeRows = useMemo(() => rows.map(toRuntimeMessage), [rows])
+  const runtime = useExternalStoreRuntime({ messages: runtimeRows, isRunning: running, onNew: async () => {} })
+
+  const expandWindow = useCallback(async (before?: () => void) => {
+    await new Promise(resolve => setTimeout(resolve, 100))
+    before?.()
+    setRows(previous => [...makeMessages(3, 5, -3), ...previous])
+    setOlderAvailable(false)
+
+    return true
+  }, [])
+
+  window.probe = {
+    ownerA: () => { setRunning(true); setSessionKey('synthetic-owner-A'); setRows(makeMessages(4, 5, 1000)) },
+    ownerB: () => {
+      saveThreadScrollPosition('synthetic-owner-B', { kind: 'offset', fromBottom: 800 })
+      setRunning(true)
+      setSessionKey('synthetic-owner-B')
+      setRows(makeMessages(4, 5, 2000))
+    },
+    appendBeforeDelayedScroll: () => appendBeforeDelayedScroll(rows, () => setRows(previous => previous.map((row, index) => index === previous.length - 1 ? extend(row, 3) : row)), delayedScrollDelivered),
+    delayedScrollDelivered: () => delayedScrollDelivered.current,
+    append: (count = 3) => setRows(previous => previous.map((row, index) => index === previous.length - 1 ? extend(row, count) : row)),
+    empty: () => { saved.current = rows; setRows([]) },
+    enableHistory: () => setOlderAvailable(true),
+    grow: (rowId: number) => setRows(previous => previous.map(row => row.rowId === rowId ? extend(row, 12) : row)),
+    heavy: () => { setRunning(false); setSessionKey('synthetic-heavy'); setRows(makeMessages(100, 40)) },
+    hydrate: () => setRows(previous => previous.map(row => ({ ...row, parts: [...row.parts] }))),
+    identity: (id: string) => rows.find(row => row.id === id)?.rowId,
+    jump: () => requestScrollToBottom('synthetic-runtime'),
+    nextTurn: () => setRows(previous => [...previous, ...makeMessages(1, 5, previous.length / 2)]),
+    reconcile: () => setRows(previous => reconcileAuthoritativeChatMessages(previous.map(row => ({ ...row, id: `hydrated-${row.rowId}`, parts: [...row.parts] })), previous)),
+    reset: () => { setRunning(false); setSessionKey('synthetic-scroll'); setRows(makeMessages()) },
+    restore: () => setRows(saved.current),
+    rows: () => rows,
+    start: () => setRunning(true),
+    stop: () => setRunning(false)
+  }
+
+  return (
+    <AssistantRuntimeProvider runtime={runtime}>
+      <RunningMarker />
+      <TranscriptWindowProvider value={{ olderAvailable, expandWindow }}>
+        <header style={{ height: 48, padding: 12 }}>SYNTHETIC · real Thread component · no backend / no user data</header>
+        {/* Fixed synthetic row geometry isolates owner changes from deferred Markdown/backfill. */}
+        <style>{'[data-probe-owner="synthetic-owner-A"] [data-slot="aui_message-group"] { min-height: 500px; } [data-probe-owner="synthetic-owner-B"] [data-slot="aui_message-group"] { min-height: 1250px; }'}</style>
+        <div data-chat-surface="" data-probe-owner={sessionKey} style={{ height: 'calc(100vh - 48px)', '--titlebar-height': '0px', '--composer-width': '800px' } as CSSProperties}>
+          <Thread sessionId="synthetic-runtime" sessionKey={sessionKey} />
+        </div>
+      </TranscriptWindowProvider>
+    </AssistantRuntimeProvider>
+  )
+}
+
+declare global {
+  interface Window {
+    probe: {
+      ownerA: () => void
+      ownerB: () => void
+      appendBeforeDelayedScroll: () => void
+      delayedScrollDelivered: () => number
+      append: (count?: number) => void
+      empty: () => void
+      enableHistory: () => void
+      grow: (rowId: number) => void
+      heavy: () => void
+      hydrate: () => void
+      identity: (id: string) => number | undefined
+      jump: () => void
+      nextTurn: () => void
+      reconcile: () => void
+      reset: () => void
+      restore: () => void
+      rows: () => ChatMessage[]
+      start: () => void
+      stop: () => void
+    }
+  }
+}
+
+createRoot(document.getElementById('root')!).render(<Probe />)
