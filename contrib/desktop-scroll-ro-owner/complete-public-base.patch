+import { AssistantRuntimeProvider, type ThreadMessage, useExternalStoreRuntime } from '@assistant-ui/react'
+import { act, render } from '@testing-library/react'
+import { expect, it, vi } from 'vitest'
+
+import { stubThreadEnvironment, stubThreadViewportSize } from '../test-utils'
+
+import { Thread } from '.'
+
+stubThreadEnvironment()
+stubThreadViewportSize()
+
+const CLIENT_HEIGHT = 600
+let contentHeight = 5000
+
+Object.defineProperty(HTMLElement.prototype, 'scrollHeight', { configurable: true, get: () => contentHeight })
+Object.defineProperty(HTMLElement.prototype, 'clientHeight', { configurable: true, get: () => CLIENT_HEIGHT })
+
+const createdAt = new Date('2026-01-01T00:00:00Z')
+
+const messages: ThreadMessage[] = [
+  { id: 'scroll-order-user', role: 'user', content: [{ type: 'text', text: 'Synthetic task' }], attachments: [], createdAt, metadata: { custom: {} } },
+  { id: 'scroll-order-assistant', role: 'assistant', content: [{ type: 'text', text: 'Synthetic streaming response' }], status: { type: 'running' }, createdAt, metadata: { unstable_state: null, unstable_annotations: [], unstable_data: [], steps: [], custom: {} } }
+]
+
+function Harness() {
